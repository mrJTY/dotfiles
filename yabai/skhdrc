# skhd — Hyprland-style bindings on top of yabai
#
# Hyprland's mainMod is SUPER; here it's `alt` instead, so nothing collides
# with macOS/app shortcuts that live on cmd (cmd+q, cmd+tab, cmd+1-9, ...).
# App-launching binds from Hyprland's default config (terminal/file-manager/
# menu on Q/E/R) are left out on purpose — those are app choices, not
# yabai/skhd concerns.

# --- Focus a window in a direction (Hyprland: mainMod + arrow) ---
alt - h : yabai -m window --focus west || yabai -m display --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east || yabai -m display --focus east

# --- Move/swap a window in a direction (Hyprland: mainMod + SHIFT + arrow) ---
alt + shift - h : yabai -m window --warp west || yabai -m window --display west
alt + shift - j : yabai -m window --warp south
alt + shift - k : yabai -m window --warp north
alt + shift - l : yabai -m window --warp east || yabai -m window --display east

# --- Window state (Hyprland: mainMod + C kill / F fullscreen) ---
# alt-c toggles float + center instead of closing (Hyprland uses it to kill
# the active window); close moved to alt-w so there's still a keyboard bind
# for it.
alt - c : yabai -m window --toggle float; yabai -m window --grid 4:4:1:1:2:2
alt - t : yabai -m window --toggle float; 
alt - p : yabai -m window --toggle float; yabai -m window --grid 4:4:1:1:2:2
alt - w : yabai -m window --close
alt - f : yabai -m window --toggle zoom-fullscreen

# Note: Hyprland's special-workspace/scratchpad has no equivalent here on
# purpose. It would need `--toggle sticky/topmost/pip`, all three of which
# require yabai's scripting addition — i.e. partially disabling SIP. Skipped.

# --- Quick half-tile: snap focused window to the left/right half of the screen ---
alt + cmd - h : yabai -m window --grid 1:2:0:0:1:1
alt + cmd - l : yabai -m window --grid 1:2:1:0:1:1

# --- Space layout + balance (bsp/stack only — no float layout, same reason) ---
alt - b : yabai -m space --layout bsp
alt - s : yabai -m space --layout stack
alt - e : yabai -m space --balance

# --- Resize mode (Hyprland: mainMod + R enters a resize submap) ---
# Enter with alt - r, resize with h/j/k/l, leave with escape or return.
:: resize

alt - r ; resize

resize < h : yabai -m window --resize left:-20:0
resize < l : yabai -m window --resize right:20:0
resize < j : yabai -m window --resize bottom:0:20
resize < k : yabai -m window --resize top:0:-20
resize < escape ; default
resize < return ; default

# --- Quick resize, no mode needed: alt - shrinks, alt = (the "+" key) grows ---
# Grows/shrinks from whichever corner has room; falls back to the opposite
# corner if the window is flush against that edge.
# 0x1B/0x18 are the Apple kVK_ANSI_Minus/kVK_ANSI_Equal keycodes — skhd's
# named literals for these two keys aren't reliable across versions, and an
# unrecognized literal here breaks parsing of the *entire* file silently.
alt - 0x1B : yabai -m window --resize bottom_right:-20:-20 || yabai -m window --resize top_left:20:20
alt - 0x18 : yabai -m window --resize bottom_right:20:20 || yabai -m window --resize top_left:-20:-20

# --- Workspaces = macOS Spaces (Hyprland: mainMod + [1-9] / SHIFT + [1-9]) ---
# Spaces 1-9 must already exist in Mission Control; yabai won't create them.
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9

alt + shift - 1 : yabai -m window --space 1
alt + shift - 2 : yabai -m window --space 2
alt + shift - 3 : yabai -m window --space 3
alt + shift - 4 : yabai -m window --space 4
alt + shift - 5 : yabai -m window --space 5
alt + shift - 6 : yabai -m window --space 6
alt + shift - 7 : yabai -m window --space 7
alt + shift - 8 : yabai -m window --space 8
alt + shift - 9 : yabai -m window --space 9

# --- Toggle the yabai service on/off (no Hyprland equivalent) ---
alt + shift - 0 : (pgrep -q yabai && yabai --stop-service) || yabai --start-service

# --- Toggle focus-follows-mouse (autofocus <-> off) ---
alt + shift - o : [ "$(yabai -m config focus_follows_mouse)" = "off" ] \
                    && yabai -m config focus_follows_mouse autofocus \
                    || yabai -m config focus_follows_mouse off

# --- Move window to another monitor, following it ---
# `window --display <arg> --focus` alone doesn't reliably switch the active
# display/space (yabai quirk, worse with "Displays have separate Spaces" on)
# — chase it with an explicit `display --focus` to actually move focus over.
alt + shift - tab : yabai -m window --display prev; yabai -m display --focus prev
ctrl + alt + shift - tab : yabai -m window --display next; yabai -m display --focus next

# --- System bindings (macOS itself, not yabai) ---
alt - tab : open -a "Mission Control"
cmd - f11 : osascript -e "set volume output volume (output volume of (get volume settings) - 10)"
cmd - f12 : osascript -e "set volume output volume (output volume of (get volume settings) + 10)"
